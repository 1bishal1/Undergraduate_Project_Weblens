{
  "manifest_version": 3,
  "name": "Weblens",
  "version": "1.0.0",
  "description": "Undergraduate Project - Weblens",
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/pointer.js",
        "src/content/color_inspector.js",
        "src/content/techstack.js",
        "src/content/hover_popup.js",
        "src/content/toolbar.js",
        "src/content/inspector.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/toolbar.html",
        "src/utils/images/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}