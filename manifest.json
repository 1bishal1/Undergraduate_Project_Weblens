{
  "manifest_version": 3,
  "name": "Weblens",
  "version": "1.0.0",
  "description": "Undergraduate Project - Weblens",
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/pointer.js",
        "src/content/hover-popup.js",
        "src/content/inspector.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}